# pistols.wtf - Environment Variables Configuration Template
# For local development and Vercel Deployment

# 1. (Optional) Supabase Cloud DB & Storage Buckets
# Create a free project at https://supabase.com
# Provides PostgreSQL database, storage for avatars & wallpapers, and serverless authentication
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. (Optional) Google Sign-in Official Client ID
# Obtain from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# 3. (Optional) Discord Bot & Application OAuth ID
# Create bot at https://discord.com/developers/applications
VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=https://pistols.wtf/dashboard
VITE_DISCORD_BOT_INVITE=https://discord.com/oauth2/authorize?client_id=YOUR_DISCORD_CLIENT_ID&scope=bot+identify&permissions=8
